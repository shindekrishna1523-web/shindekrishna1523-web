        </div>

    </form>
</div>

<table id="employeeGrid" class="display nowrap" style="width:100%">
    <thead>
        <tr>
            <th>Approved</th>
            <th>Code</th>
            <th>Short Name</th>
            <th>Full Name</th>
            <th>Badge</th>
            <th>Join Date</th>
            <th>Department</th>
            <th>Section</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (System.Data.DataRow row in Model.Rows)
