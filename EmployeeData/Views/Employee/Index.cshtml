                <td>@($"{row["FirstName"]} {row["MiddleName"]} {row["Surname"]}")</td>
                <td>@row["BadgeNo"]</td>
                <td>@row["JoiningDate"]</td>
                <td>@row["DepartmentId"]</td>
                <td>@row["SectionId"]</td>
                <td>
                    <a class="btn btn-sm btn-primary" href="/Employee/Edit/@row["EmployeeId"]">Edit</a>
                </td>
            </tr>
        }
    </tbody>

    <tfoot>
        <tr>
            <th>Approved</th>
            <th>Code</th>
            <th>Short Name</th>
            <th>Full Name</th>
            <th>Badge</th>
            <th>Join Date</th>
            <th>Department</th>
            <th>Section</th>
            <th></th>
        </tr>
    </tfoot>
</table>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/fixedheader/3.3.2/js/dataTables.fixedHeader.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.3.6/js/dataTables.buttons.min.js"></script>

<script>
    $(document).ready(function () {

        // DataTable with Filter Row
        var table = $('#employeeGrid').DataTable({
            paging: true,
            scrollX: true,
            fixedHeader: true,
            initComplete: function () {

                // ADD FILTER ROW (exactly like DevExpress)
                this.api().columns().every(function () {
                    var column = this;

                    var input = $('<input class="form-control form-control-sm" />')
                        .appendTo($(column.footer()).empty())
                        .on('keyup change clear', function () {
                            if (column.search() !== this.value) {
                                column.search(this.value).draw();
                            }
                        });
                });

            }
        });

    });
</script> *@



@model System.Data.DataTable

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<h2 class="mb-3">Employee</h2>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link active" href="#">List</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" href="/Employee/Create">Entry Details</a>
    </li>
</ul>

<div class="card p-3 mb-3">
    <h5>Search Criteria</h5>

    <form method="get">
        <div class="row g-2">

            <div class="col-md-3">
                <label>Name</label>
                <input type="text" name="Name" class="form-control" />
            </div>

            <div class="col-md-2">
                <label>Emp Code</label>
                <input type="text" name="Code" class="form-control" />
            </div>

            <div class="col-md-2">
                <label>Department</label>
                <input type="text" name="Department" class="form-control" />
            </div>

            <div class="col-md-2">
                <label>Badge No</label>
                <input type="text" name="BadgeNo" class="form-control" />
            </div>

            <div class="col-md-3 d-flex align-items-end">
                <div class="form-check me-3">
                    <input type="checkbox" name="Active" class="form-check-input" />
                    <label class="form-check-label">Active</label>
                </div>

                <div class="form-check me-3">
                    <input type="checkbox" name="Approved" class="form-check-input" />
                    <label class="form-check-label">Approved</label>
                </div>

                <button class="btn btn-primary">Find</button>
            </div>

        </div>
    </form>
</div>

<table class="table table-bordered table-striped table-sm">
    <thead class="table-light">
        <tr>
            <th>Approved</th>
            <th>Code</th>
            <th>Short Name</th>
            <th>Full Name</th>
            <th>Badge</th>
            <th>Join Date</th>
            <th>Department</th>
            <th>Section</th>
            <th>Process</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (System.Data.DataRow row in Model.Rows)
        {
            <tr>
                <td>@row["Approved"]</td>
                <td>@row["EmployeeCode"]</td>
                <td>@row["FirstName"]</td>
                <td>@row["FirstName"] @row["MiddleName"] @row["Surname"]</td>
                <td>@row["BadgeNo"]</td>
                <td>@row["JoiningDate"]</td>
                <td>@row["DepartmentId"]</td>
                <td>@row["SectionId"]</td>
                <td>@row["ShortName"]</td>

                <td>
                    <a href="/Employee/Edit/@row["EmployeeId"]" class="btn btn-sm btn-warning">Edit</a>
                    <a href="/Employee/Delete/@row["EmployeeId"]" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
