<!-- Full corrected Create View (no nested forms, working Save, working Delete, fixed layout) -->
@model MODEL.EmployeeModel
@{
    ViewData["Title"] = "Add Employee";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>
    .winform-container {
        width: 100%;
        padding: 12px;
        font-family: Segoe UI, Arial;
        font-size: 13px;
        position: relative;
    }

    .panel {
        border: 1px solid #cfcfcf;
        background: #fff;
        padding: 12px;
        margin-bottom: 12px;
        border-radius: 4px;
    }

    .titlebar {
        font-weight: 700;
        padding: 8px 10px;
        background: #f7f7f7;
        border: 1px solid #e6e6e6;
        border-radius: 4px;
        margin-bottom: 12px;
    }

    .lbl {
        width: 140px;
        font-weight: 600;
    }

    .input-fixed {
        width: 100%;
        max-width: 320px;
        display: inline-block;
    }

    .small-input {
        width: 160px;
        display: inline-block;
    }

    .photo-box {
        width: 170px;
        height: 170px;
        border: 1px solid #bfbfbf;
        background: #f7f7f7;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .right-vertical {
        width: 130px;
        position: absolute;
        right: 18px;
        top: 72px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .side-btn {
        width: 100%;
        padding: 8px;
        background: #fff;
        border: 1px solid #ddd;
        cursor: pointer;
        text-align: left;
        border-radius: 4px;
    }

    .copy-arrow {
        width: 48px;
        height: 48px;
        border: 1px solid #bfbfbf;
        background: #e9f5ff;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-weight: 800;
        border-radius: 4px;
    }

    .process-grid {
        width: 100%;
        border: 1px solid #ddd;
        border-collapse: collapse;
        margin-top: 8px;
    }

        .process-grid th, .process-grid td {
            border: 1px solid #ddd;
            padding: 6px;
        }

    .muted {
        color: #888;
    }
</style>

<div class="winform-container">

    <!-- Right vertical action buttons -->
    <div class="right-vertical">
        <div style="text-align:center; color:#d9534f; font-weight:700;">Add Mode</div>
        <button type="button" class="side-btn" onclick="location.href='@Url.Action("Edit", "Employee", new { id = Model.ID })'">Edit</button>
        <button type="button" class="side-btn" onclick="location.href='@Url.Action("Create", "Employee")'">Clear</button>
        <button type="button" class="side-btn" style="color:#c9302c;" onclick="deleteEmployee(@Model.ID)">Delete</button>
        <button type="button" class="side-btn" onclick="location.href='@Url.Action("Index", "Employee")'">Close</button>

        <div style="border-top:1px solid #eee; margin-top:8px; padding-top:6px;">
            <button type="button" class="side-btn" onclick="openFeature('doc')">Doc</button>
            <button type="button" class="side-btn" onclick="openFeature('skill')">Skill</button>
            <button type="button" class="side-btn" onclick="openFeature('salary')">Salary</button>
            <button type="button" class="side-btn" onclick="openFeature('investment')">Investment</button>
        </div>
    </div>

    <h4 class="titlebar">Employee</h4>

    <form asp-controller="Employee" asp-action="Create" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ID" />

        <!-- TOP: Basic / Photo / Status -->
        <div class="panel row">
            <div class="col-md-8">
                <div class="row g-2">
                    <div class="col-md-6 d-flex align-items-center">
                        <label class="lbl">Branch :</label>
                        <input asp-for="BranchID" class="form-control input-fixed" placeholder="Branch ID or select" />
                    </div>
                    <div class="col-md-6 d-flex align-items-center">
                        <label class="lbl">Application Date :</label>
                        <input asp-for="ApplicationDate" type="date" class="form-control small-input" />
                    </div>

                    <div class="col-md-6 d-flex align-items-center">
                        <label class="lbl">First Name :</label>
                        <input asp-for="FirstName" class="form-control input-fixed" />
                    </div>
                    <div class="col-md-6 d-flex align-items-center">
                        <label class="lbl">Join Date :</label>
                        <input asp-for="JoinDate" type="date" class="form-control small-input" />
                    </div>

                    <div class="col-md-6 d-flex align-items-center">
                        <label class="lbl">Middle Name :</label>
                        <input asp-for="MiddleName" class="form-control input-fixed" />
                    </div>
                    <div class="col-md-6 d-flex align-items-center">
                        <label class="lbl">Left Date :</label>
                        <input asp-for="LeftDate" type="date" class="form-control small-input" />
                    </div>

                    <div class="col-md-6 d-flex align-items-center">
                        <label class="lbl">Surname :</label>
                        <input asp-for="LastName" class="form-control input-fixed" />
                    </div>
                    <div class="col-md-6 d-flex align-items-center">
                        <label class="lbl">Employee Code :</label>
                        <input asp-for="Code" class="form-control input-fixed" readonly />
                    </div>

                    <div class="col-md-6 d-flex align-items-center">
                        <label class="lbl">Department :</label>
                        <input asp-for="DeptID" class="form-control input-fixed" />
                    </div>
                    <div class="col-md-6 d-flex align-items-center">
                        <label class="lbl">Badge No :</label>
                        <input asp-for="BadgeNo" type="number" class="form-control input-fixed" />
                    </div>

                    <div class="col-md-6 d-flex align-items-center">
                        <label class="lbl">Section :</label>
                        <input asp-for="SecID" class="form-control input-fixed" />
                    </div>
                    <div class="col-md-6 d-flex align-items-center">
                        <label class="lbl">Gender :</label>
                        <select asp-for="Gender" class="form-control input-fixed">
                            <option value="">--Select--</option>
                            <option>Male</option>
                            <option>Female</option>
                            <option>Other</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Photo & Status -->
            <div class="col-md-4 text-center">
                <div class="photo-box mb-2" id="photoPreview">
                    @if (!string.IsNullOrEmpty(Model.PhotoPath))
                    {
                        <img src="~/@Model.PhotoPath" style="max-width:100%; max-height:100%;" />
                    }
                    else if (Model.PhotoPath != null && Model.PhotoPath.Length > 0)
                    {
                        <!-- if you have blob, you need action to stream it; showing placeholder for now -->
                        <span class="muted">Photo</span>
                    }
                    else
                    {
                        <span class="muted">Photo</span>
                    }
                </div>

                <div class="mb-2">
                    <input type="file" name="Photo" id="Photo" class="form-control" onchange="previewPhoto(this)" />
                </div>

                <div class="d-flex justify-content-center gap-2 mb-2">
                    <button type="button" class="btn btn-light btn-sm" onclick="document.getElementById('Photo').click()">Browse</button>
                    <button type="button" class="btn btn-light btn-sm" onclick="clearPhoto()">Delete</button>
                </div>

                <div class="text-start">
                    <div class="form-check">
                        <input asp-for="IsApproved" class="form-check-input" type="checkbox" />
                        <label class="form-check-label">Approved</label>
                    </div>
                    <div class="form-check">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label class="form-check-label">Active</label>
                    </div>
                    <div class="form-check">
                        <input asp-for="FileComplete" class="form-check-input" type="checkbox" />
                        <label class="form-check-label">FileComplete</label>
                    </div>
                    <div class="form-check">
                        <input asp-for="Trainee" class="form-check-input" type="checkbox" />
                        <label class="form-check-label">Trainee</label>
                    </div>
                </div>
            </div>
        </div>

        <!-- ADDRESS PANEL -->
        <div class="panel">
            <div class="row">
                <div class="col-md-5">
                    <h6>Current Address</h6>
                    <div class="mb-2 d-flex">
                        <label class="lbl">Address 1 :</label>
                        <input asp-for="Address1" class="form-control" />
                    </div>
                    <div class="mb-2 d-flex">
                        <label class="lbl">Address 2 :</label>
                        <input asp-for="Address2" class="form-control" />
                    </div>
                    <div class="mb-2 d-flex">
                        <label class="lbl">Address 3 :</label>
                        <input asp-for="Address3" class="form-control" />
                    </div>
                    <div class="row g-2">
                        <div class="col-md-6 d-flex align-items-center">
                            <label class="lbl">City :</label>
                            <input asp-for="City" class="form-control small-input" />
                        </div>
                        <div class="col-md-6 d-flex align-items-center">
                            <label class="lbl">State :</label>
                            <input asp-for="State" class="form-control small-input" />
                        </div>
                        <div class="col-md-6 d-flex align-items-center mt-2">
                            <label class="lbl">Country :</label>
                            <input asp-for="Country" class="form-control small-input" />
                        </div>
                        <div class="col-md-6 d-flex align-items-center mt-2">
                            <label class="lbl">Zip :</label>
                            <input asp-for="ZipCode" class="form-control small-input" />
                        </div>
                    </div>
                </div>

                <div class="col-md-1 d-flex align-items-center justify-content-center">
                    <div class="copy-arrow" title="Copy to permanent" onclick="copyAddress()">»</div>
                </div>

                <div class="col-md-6">
                    <h6>Permanent Address</h6>
                    <div class="mb-2 d-flex">
                        <label class="lbl">Address 1 :</label>
                        <input asp-for="PermAddress1" class="form-control" />
                    </div>
                    <div class="mb-2 d-flex">
                        <label class="lbl">Address 2 :</label>
                        <input asp-for="PermAddress2" class="form-control" />
                    </div>
                    <div class="mb-2 d-flex">
                        <label class="lbl">Address 3 :</label>
                        <input asp-for="PermAddress3" class="form-control" />
                    </div>
                    <div class="row g-2">
                        <div class="col-md-6 d-flex align-items-center">
                            <label class="lbl">City :</label>
                            <input asp-for="PermCity" class="form-control small-input" />
                        </div>
                        <div class="col-md-6 d-flex align-items-center">
                            <label class="lbl">State :</label>
                            <input asp-for="PermState" class="form-control small-input" />
                        </div>
                        <div class="col-md-6 d-flex align-items-center mt-2">
                            <label class="lbl">Country :</label>
                            <input asp-for="PermCountry" class="form-control small-input" />
                        </div>
                        <div class="col-md-6 d-flex align-items-center mt-2">
                            <label class="lbl">Zip :</label>
                            <input asp-for="PermZip" class="form-control small-input" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- CONTACT & PERSONAL PANEL -->
        <div class="panel row">
            <div class="col-md-6">
                <h6>Contact & Personal</h6>
                <div class="mb-2 d-flex">
                    <label class="lbl">Mobile :</label>
                    <input asp-for="ContactNo1" class="form-control input-fixed" />
                </div>
                <div class="mb-2 d-flex">
                    <label class="lbl">Emergency No :</label>
                    <input asp-for="EmergencyNo" class="form-control input-fixed" />
                </div>
                <div class="mb-2 d-flex">
                    <label class="lbl">Birth Date :</label>
                    <input asp-for="BirthDate" type="date" class="form-control small-input" />
                </div>
                <div class="mb-2 d-flex">
                    <label class="lbl">Birth Place :</label>
                    <input asp-for="BirthPlace" class="form-control input-fixed" />
                </div>
            </div>

            <div class="col-md-6">
                <h6>Other Personal</h6>
                <div class="mb-2 d-flex">
                    <label class="lbl">Blood Group :</label>
                    <input asp-for="BloodGroup" class="form-control small-input" />
                </div>
                <div class="mb-2 d-flex">
                    <label class="lbl">Email ID :</label>
                    <input asp-for="Email" type="email" class="form-control input-fixed" />
                </div>
                <div class="mb-2 d-flex">
                    <label class="lbl">Reference By :</label>
                    <input asp-for="ReferenceBy" class="form-control input-fixed" />
                </div>
                <div class="mb-2 d-flex">
                    <label class="lbl">Short Name :</label>
                    <input asp-for="ShortName" class="form-control small-input" />
                </div>
            </div>
        </div>

        <!-- BANK & GOVT IDs PANEL -->
        <div class="panel row">
            <div class="col-md-6">
                <h6>Bank Details</h6>
                <div class="mb-2 d-flex">
                    <label class="lbl">Bank Name :</label>
                    <input asp-for="BankName" class="form-control input-fixed" />
                </div>
                <div class="mb-2 d-flex">
                    <label class="lbl">Bank A/C No :</label>
                    <input asp-for="BankAccountNo" class="form-control input-fixed" />
                </div>
                <div class="mb-2 d-flex">
                    <label class="lbl">IFSC Code :</label>
                    <input asp-for="IFSCCode" class="form-control small-input" />
                </div>
            </div>

            <div class="col-md-6">
                <h6>Govt IDs</h6>
                <div class="mb-2 d-flex">
                    <label class="lbl">PAN No :</label>
                    <input asp-for="PANNo" class="form-control input-fixed" />
                </div>
                <div class="mb-2 d-flex">
                    <label class="lbl">Aadhar Card No :</label>
                    <input asp-for="AadharCardNo" class="form-control input-fixed" />
                </div>
                <div class="mb-2 d-flex">
                    <label class="lbl">GST No :</label>
                    <input asp-for="GSTNo" class="form-control input-fixed" />
                </div>
            </div>
        </div>

        <!-- JOB DETAILS PANEL -->
        <div class="panel row">
            <div class="col-md-6">
                <h6>Job Details</h6>
                <div class="mb-2 d-flex">
                    <label class="lbl">Shift :</label>
                    <input asp-for="Shift" class="form-control small-input" />
                </div>
                <div class="mb-2 d-flex">
                    <label class="lbl">Payroll Type :</label>
                    <input asp-for="PayrollType" class="form-control small-input" />
                </div>
                <div class="mb-2 d-flex">
                    <label class="lbl">Job Type :</label>
                    <input asp-for="JobType" class="form-control input-fixed" />
                </div>
            </div>

            <div class="col-md-6">
                <h6>More Job</h6>
                <div class="mb-2 d-flex">
                    <label class="lbl">Grade :</label>
                    <input asp-for="Grade" class="form-control small-input" />
                </div>
                <div class="mb-2 d-flex">
                    <label class="lbl">P.F. No :</label>
                    <input asp-for="PFNo" class="form-control input-fixed" />
                </div>
                <div class="mb-2 d-flex">
                    <label class="lbl">P.F. Date :</label>
                    <input asp-for="PFDate" type="date" class="form-control small-input" />
                </div>
            </div>
        </div>

        <!-- Processes / Skills panel -->
        <div class="panel">
            <div class="d-flex justify-content-between align-items-center">
                <h6 class="mb-0">Process / Skill</h6>
                <div>
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="addProcessRow()">Add</button>
                </div>
            </div>

            <table class="process-grid w-100">
                <thead>
                    <tr><th style="width:40px;">#</th><th>Process</th><th style="width:110px;">Action</th></tr>
                </thead>
                <tbody id="processBody">
                    @if (Model.Processes != null && Model.Processes.Count > 0)
                    {
                        for (int i = 0; i < Model.Processes.Count; i++)
                        {
                            <tr>
                                <td>@(i + 1)</td>
                                <td><input name="Processes[@i]" value="@Model.Processes[i]" class="form-control" /></td>
                                <td><button type="button" class="btn btn-sm btn-danger" onclick="removeRow(this)">Remove</button></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td>1</td>
                            <td><input name="Processes[0]" class="form-control" /></td>
                            <td><button type="button" class="btn btn-sm btn-danger" onclick="removeRow(this)">Remove</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Save / Cancel -->
        <div class="d-flex justify-content-end gap-2 mb-4">
            <button type="submit" class="btn btn-success">Save</button>
            <a href="@Url.Action("Index", "Employee")" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

<script>
    function copyAddress() {
        const map = [
            ['Address1', 'PermAddress1'],
            ['Address2', 'PermAddress2'],
            ['Address3', 'PermAddress3'],
            ['City', 'PermCity'],
            ['State', 'PermState'],
            ['Country', 'PermCountry'],
            ['ZipCode', 'PermZip']
        ];
        map.forEach(x => {
            const src = document.querySelector(`[name="${x[0]}"]`);
            const dst = document.querySelector(`[name="${x[1]}"]`);
            if (src && dst) dst.value = src.value;
        });
    }

    function addProcessRow() {
        var tb = document.getElementById('processBody');
        var i = tb.rows.length;
        var tr = document.createElement('tr');
        tr.innerHTML = `<td>${i + 1}</td>
                        <td><input name="Processes[${i}]" class="form-control" /></td>
                        <td><button type="button" class="btn btn-sm btn-danger" onclick="removeRow(this)">Remove</button></td>`;
        tb.appendChild(tr);
    }

    function removeRow(btn) {
        var tr = btn.closest('tr'); if (!tr) return;
        tr.remove();
        var rows = document.querySelectorAll('#processBody tr');
        rows.forEach((r, idx) => {
            r.cells[0].innerText = idx + 1;
            var input = r.querySelector('input');
            if (input) input.name = `Processes[${idx}]`;
        });
    }

    function previewPhoto(el) {
        var f = el.files[0]; if (!f) return;
        var rd = new FileReader();
        rd.onload = function (e) {
            document.getElementById('photoPreview').innerHTML = `<img src="${e.target.result}" style="max-width:100%; max-height:100%;" />`;
        }
        rd.readAsDataURL(f);
    }

    function clearPhoto() {
        var p = document.getElementById('Photo');
        if (p) p.value = '';
        document.getElementById('photoPreview').innerHTML = '<span class="muted">Photo</span>';
    }

    function deleteEmployee(id) {
        if (!id || id == 0) { alert('No employee selected to delete.'); return; }
        if (!confirm('Delete this employee?')) return;
        var f = document.createElement('form'); f.method = 'post'; f.action = '@Url.Action("Delete", "Employee")';
        var token = document.createElement('input'); token.type = 'hidden'; token.name = '__RequestVerificationToken';
        var tokenField = document.querySelector('input[name="__RequestVerificationToken"]');
        if (tokenField) token.value = tokenField.value;
        var hidden = document.createElement('input'); hidden.type = 'hidden'; hidden.name = 'id'; hidden.value = id;
        f.appendChild(token); f.appendChild(hidden); document.body.appendChild(f); f.submit();
    }

    function openFeature(name) {
        // implement as popup or navigation
        alert('Open ' + name + ' (implement navigation/pop-up)');
    }
</script>



